# IESA environment variables – copy to .env and customise
# cp .env.example .env

# Database
DATABASE_PATH=data/iesa.db

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=logs

# OLED display
OLED_I2C_ADDRESS=0x3C

# Guest data retention (hours)
GUEST_RETENTION_HOURS=24

# USB Camera
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Raspberry Pi AI HAT+ (Hailo-8L)
AI_HAT_ENABLED=true
AI_HAT_DEVICE=/dev/hailo0
SPEECH_SAMPLE_RATE=16000
SPEECH_LANGUAGE=en
